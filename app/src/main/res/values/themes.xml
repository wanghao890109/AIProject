<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.AIProject" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/main_back_color</item>
        <item name="colorPrimaryVariant">@color/main_back_color</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/purple</item>
        <item name="colorSecondaryVariant">@color/purple</item>
        <item name="android:textAllCaps">false</item>
        <item name="colorAccent">@color/purple</item>

        <item name="android:windowBackground">@color/main_back_color</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="buttonStyle">@style/Widget.AppCompat.Button.Borderless</item>
        <!-- Customize your theme here. -->
    </style>
</resources>