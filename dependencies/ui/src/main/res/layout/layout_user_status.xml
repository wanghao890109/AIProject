<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="56dp"
    xmlns:tools="http://schemas.android.com/tools">

    <com.hao.ui.widget.imageview.CompatImageView
        android:id="@+id/iv_user_icon_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:iv_circleType="circle"
        android:background="@drawable/rectangle_radius_100dp_bg_ffc811"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"
        tools:visibility="visible"/>

    <com.hao.ui.widget.imageview.CompatImageView
        android:id="@+id/iv_user_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:iv_circleType="circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.hao.ui.widget.VoicePlayingIcon
        android:id="@+id/voice_playing"
        android:layout_width="20dp"
        android:layout_height="12dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/rectangle_radius_2dp_bg_ffc811_stroke_ffffff"
        android:padding="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:pointer_color="@color/white"
        app:pointer_num="4"
        app:pointer_width="1.5"
        tools:visibility="visible"
        android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>