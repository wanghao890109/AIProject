<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CompatImageView">
        <attr name="iv_placeHolder" format="reference" /><!--占位图-->
        <attr name="iv_errorDrawable" format="reference" /><!--加载失败图-->
        <attr name="iv_radius" format="dimension" /><!--圆角大小-->
        <!--        <attr name="iv_blurRadius" format="dimension" />&lt;!&ndash;高斯模糊&ndash;&gt;-->
        <attr name="iv_fade" format="boolean" /><!--是否渐显-->
        <attr name="iv_fadeTime" format="integer" /><!--渐显时间，默认500-->
        <attr name="iv_strokeWidth" format="dimension" /><!--边宽宽度-->
        <attr name="iv_strokeColor" format="reference|color" /><!--边宽颜色-->
        <attr name="iv_circleType" format="enum"><!--显示模式，圆形or方形-->
            <enum name="none" value="0" />
            <enum name="circle" value="1" />
            <enum name="square" value="2" />
        </attr>
        <attr name="iv_enableCorner">
            <enum name="all" value="0" />

            <enum name="hideTop" value="1" />
            <enum name="hideRight" value="2" />
            <enum name="hideBottom" value="3" />
            <enum name="hideLeft" value="4" />

            <enum name="onlyLeftTop" value="5" />
            <enum name="onlyRightTop" value="6" />
            <enum name="onlyRightBottom" value="7" />
            <enum name="onlyLeftBottom" value="8" />

        </attr>

    </declare-styleable>
</resources>